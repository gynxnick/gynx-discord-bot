{
  "name": "@gynx/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "commands:register": "tsx --env-file-if-exists=../../.env src/scripts/register-commands.ts",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.3",
    "@gynx/config": "workspace:^",
    "@gynx/database": "workspace:^",
    "@gynx/permissions": "workspace:^",
    "@gynx/services": "workspace:^",
    "@gynx/shared": "workspace:^",
    "@prisma/client": "^6.2.1",
    "discord-api-types": "^0.38.57",
    "discord.js": "^14.27.0",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "tsx": "^4.19.2"
  }
}
