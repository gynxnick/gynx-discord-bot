# GYNX Discord Bot — example configuration
# Copy to `.env` for local development. PLACEHOLDERS ONLY — never commit real values.
# Guild-specific settings (channels, roles, templates, thresholds overrides) live in the
# database and are edited from the dashboard, not here.

NODE_ENV=development
LOG_LEVEL=info

# ── Discord application (Developer Portal → your application) ──────────────
# Bot token (Bot tab). Required by bot, worker and dashboard (dashboard uses it read-only
# to verify guild membership/roles and list channels).
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# The GYNX.GG guild this deployment serves (use a separate test guild for development).
DISCORD_GUILD_ID=
# OAuth2 tab. Redirect URL must be: ${DASHBOARD_URL}/api/auth/callback
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=

# ── Infrastructure ─────────────────────────────────────────────────────────
# postgresql://USER:PASSWORD@HOST:5432/DB?schema=public
DATABASE_URL=
# Optional. Enables shared rate limits across multiple bot/dashboard instances.
REDIS_URL=

# ── Dashboard ──────────────────────────────────────────────────────────────
DASHBOARD_URL=http://localhost:3000
# At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=
SESSION_TTL_HOURS=12
# 32 bytes hex for AES-256-GCM encryption of integration secrets: openssl rand -hex 32
ENCRYPTION_KEY=
# Optional, dashboard: signs GitHub webhook deliveries for the update feed (POST /api/webhooks/github).
# Unset = the webhook endpoint answers 503. Generate with: openssl rand -hex 32
# GITHUB_WEBHOOK_SECRET=

DEFAULT_TIMEZONE=UTC

# ── Health endpoints ───────────────────────────────────────────────────────
BOT_HEALTH_PORT=8081
WORKER_HEALTH_PORT=8082

# ── Status monitoring defaults (per-guild overrides in the dashboard) ──────
STATUS_CHECK_INTERVAL_SECONDS=60
STATUS_FAILURE_THRESHOLD=3
STATUS_RECOVERY_THRESHOLD=2

# ── Troubleshooting / diagnostics ──────────────────────────────────────────
DIAGNOSTIC_RETENTION_HOURS=24
# Comma-separated hostname suffixes /portcheck may target (e.g. gynx.gg). Empty = /portcheck disabled.
PORTCHECK_ALLOWED_SUFFIXES=

# ── Weekly CEO report ──────────────────────────────────────────────────────
WEEKLY_REPORT_ENABLED=true
WEEKLY_REPORT_DAY=MONDAY
WEEKLY_REPORT_TIME=09:00
